{
  "name": "orbit",
  "version": "0.3.0",
  "description": "All-in-one agentic development & devops workspace",
  "main": "./out/main/index.js",
  "author": {
    "name": "Arman Omerovic",
    "email": "oarman93@gmail.com"
  },
  "license": "MIT",
  "productName": "Orbit",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "postinstall": "node scripts/fix-node-pty.cjs && electron-builder install-app-deps",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "build:win": "npm run build && electron-builder --win --publish never",
    "build:linux": "bash scripts/build-linux.sh",
    "dist": "npm run build:mac && npm run build:win && npm run build:linux"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^3.6.0",
    "dompurify": "^3.4.15",
    "electron-updater": "^6.8.11",
    "marked": "^14.0.0",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ssh2": "^1.17.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "fsevents@2.3.3": true,
    "ssh2@1.17.0": true,
    "electron@45.2.3": true,
    "electron-winstaller@5.4.0": true,
    "cpu-features": false
  },
  "homepage": "https://github.com/FlaShadowK/orbit",
  "desktopName": "orbit.desktop"
}
